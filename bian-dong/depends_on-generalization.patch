+                       err, sizeof(err))) {
+        char msg[192];
+        snprintf(msg, sizeof(msg), "Rejected: %s", err);
+        sc_overlay_manager_set_hint(ov, msg);
+        LOGW("Manager dependency rejected: %s", err);
+        return;
+    }
+    sc_overlay_manager_set_hint(ov, "Dependency cleared (press S to save)");
 }
 
