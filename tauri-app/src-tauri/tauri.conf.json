{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "scrcpy-control-panel",
  "version": "1.0.0",
  "identifier": "com.fggre6.scrcpy.panel",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "scrcpy 控制面板",
        "label": "main",
        "width": 1120,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
